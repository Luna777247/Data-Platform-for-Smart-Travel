# ============================================================================
# SMART TOURISM DATA PLATFORM - Environment Configuration Template
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values trong .env file
# 3. NEVER commit .env file to git (đã có trong .gitignore)
# 4. Keep .env.example trong repo để làm template cho team members
#
# SECURITY NOTES:
# - Tất cả secrets/passwords phải được thay đổi trong production
# - Dùng strong passwords (16+ chars, mixed case, numbers, symbols)
# - JWT secrets nên được generate với: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 
# DOMAINS:
# - Development: localhost, 127.0.0.1
# - Staging: staging-api.smarttravel.vn
# - Production: api.smarttravel.vn
# ============================================================================
# ============================================================================
# SMART TRAVEL DATA PLATFORM - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Keep .env in .gitignore and never commit secrets

# ============================================================================
# SECTION 1: DATABASE CONFIGURATION
# ============================================================================
# MongoDB là primary database cho ứng dụng này
# PostgreSQL và MinIO optional cho extended features

# ----------------------------------------
# MongoDB (Primary Database)
# ----------------------------------------
# MONGODB_URI: Full connection string (override individual settings nếu được set)
# Format: mongodb://[username:password@]host1[:port1][,...hostN[:portN]][/[database][?options]]
# Ví dụ với replica set: mongodb://user:pass@host1:27017,host2:27017/db?replicaSet=rs0
MONGODB_URI=mongodb://admin:${MONGODB_PASSWORD}@localhost:27017/smart_travel

# MONGODB_USER: Username cho MongoDB authentication
# Default: admin (nên thay đổi trong production)
MONGODB_USER=admin

# MONGODB_PASSWORD: Password cho MongoDB user
# SECURITY: PHẢI thay đổi password này trong production!
# Generate mạnh password: openssl rand -base64 32
MONGODB_PASSWORD=your_secure_mongodb_password_here

# MONGODB_DATABASE: Tên database chính
# Default: smart_travel
MONGODB_DATABASE=smart_travel

# MONGODB_HOST: MongoDB server hostname
# Development: localhost
# Docker: mongodb (tên service trong docker-compose)
MONGODB_HOST=localhost

# MONGODB_PORT: MongoDB server port
# Default: 27017
MONGODB_PORT=27017

# DB_NAME: Alias cho MONGODB_DATABASE (backward compatibility)
DB_NAME=smart_travel

# ----------------------------------------
# PostgreSQL (Optional - cho extended analytics)
# ----------------------------------------
# PostgreSQL connection string nếu dùng SQL features
POSTGRES_URL=postgresql+asyncpg://admin:${POSTGRES_PASSWORD}@localhost:5432/smart_travel

# POSTGRES_USER: PostgreSQL username
POSTGRES_USER=admin

# POSTGRES_PASSWORD: PostgreSQL password (PHẢI thay đổi!)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# POSTGRES_DB: PostgreSQL database name
POSTGRES_DB=smart_travel

# POSTGRES_PORT: PostgreSQL port
POSTGRES_PORT=5432

# ----------------------------------------
# Redis (Cache & Queue)
# ----------------------------------------
# REDIS_URL: Full Redis connection string
# Format: redis://[username:password@]host:port[/db]
REDIS_URL=redis://localhost:6379

# REDIS_HOST: Redis server hostname
# Development: localhost
# Docker: redis (tên service trong docker-compose)
REDIS_HOST=localhost

# REDIS_PORT: Redis server port
# Default: 6379
REDIS_PORT=6379

# REDIS_PASSWORD: Redis password (optional nhưng recommended cho production)
REDIS_PASSWORD=your_secure_redis_password_here

# REDIS_DB: Redis database number (0-15)
# Default: 0 cho cache, 1 cho Celery broker
REDIS_DB=0

# ----------------------------------------
# MinIO (Object Storage - Optional)
# ----------------------------------------
# Dùng cho lưu trữ large files: images, backups, exports
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_secure_minio_secret_here

# ============================================================================
# SECTION 2: APPLICATION CONFIGURATION
# ============================================================================
# Core settings cho FastAPI application

# ----------------------------------------
# Environment & Debug
# ----------------------------------------
# ENVIRONMENT: Môi trường chạy ứng dụng
# Allowed values: development, staging, production
# - development: Debug enabled, detailed error messages
# - staging: Production-like nhưng với test data
# - production: Optimized, minimal logging, strict security
ENVIRONMENT=development

# DEBUG: Enable debug mode
# true: Development mode với auto-reload, detailed errors
# false: Production mode (default khi ENVIRONMENT=production)
DEBUG=true

# LOG_LEVEL: Mức độ ghi log
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: DEBUG hoặc INFO
# Production: INFO hoặc WARNING
LOG_LEVEL=INFO

# ----------------------------------------
# Security & Authentication
# ----------------------------------------
# SECRET_KEY: Master secret key cho ứng dụng
# Dùng cho: session signing, CSRF protection, various encryptions
# GENERATE: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: PHẢI thay đổi trong production! Không được dùng default này!
SECRET_KEY=your_super_secret_key_change_this_in_production

# JWT_SECRET: Secret key riêng cho JWT token signing
# Dùng cho: Access tokens và refresh tokens
# Có thể giống SECRET_KEY hoặc khác để rotate independently
# GENERATE: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ALGORITHM: JWT signing algorithm
# Recommended: HS256 (HMAC-SHA256) - fast và secure
# Alternatives: HS384, HS512 (stronger nhưng slower)
ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: Thời gian sống của access token (phút)
# Default: 30 phút
# Ngắn hơn = secure hơn nhưng user phải login thường xuyên
ACCESS_TOKEN_EXPIRE_MINUTES=30

# REFRESH_TOKEN_EXPIRE_DAYS: Thời gian sống của refresh token (ngày)
# Default: 7 ngày
# Refresh tokens dùng để lấy access token mới khi access token hết hạn
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------
# CORS & Security Headers
# ----------------------------------------
# ALLOWED_ORIGINS: Danh sách domains được phép truy cập API
# Format: comma-separated, không có spaces sau dấu phẩy
# Ví dụ: http://localhost:3000,https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# CORS_ALLOW_CREDENTIALS: Cho phép cookies trong cross-origin requests
# true: Frontend có thể gửi cookies/authentication headers
# false: Chỉ cho phép anonymous requests
CORS_ALLOW_CREDENTIALS=true

# ----------------------------------------
# Rate Limiting
# ----------------------------------------
# RATE_LIMIT_ENABLED: Bật/tắt rate limiting
# true: Giới hạn requests per IP/user
# false: Không giới hạn (chỉ cho development)
RATE_LIMIT_ENABLED=true

# RATE_LIMIT_REQUESTS_PER_MINUTE: Số requests tối đa mỗi phút
# Default: 60 (1 request per second trung bình)
# Giảm xuống nếu API bị abuse, tăng lên cho internal services
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# RATE_LIMIT_REQUESTS_PER_HOUR: Số requests tối đa mỗi giờ
# Default: 1000
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ============================================================================
# SECTION 3: EXTERNAL API INTEGRATIONS
# ============================================================================
# API keys và credentials cho third-party services

# ----------------------------------------
# Google Places API
# ----------------------------------------
# GOOGLE_PLACES_API_KEY: API key cho Google Places service
# Dùng cho: Lấy thông tin POI từ Google Maps database
# Get key tại: https://developers.google.com/maps/documentation/places/web-service
# IMPORTANT: Enable Places API trong Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# GOOGLE_PLACES_API_VERSION: Phiên bản API
# Default: v1 (latest)
GOOGLE_PLACES_API_VERSION=v1

# ----------------------------------------
# TripAdvisor API (Optional)
# ----------------------------------------
# TRIPADVISOR_API_KEY: API key cho TripAdvisor Content API
# Dùng cho: Reviews, ratings, photos cho hotels và attractions
TRIPADVISOR_API_KEY=your_tripadvisor_api_key_here

# ----------------------------------------
# OpenStreetMap / Overpass API (Built-in, không cần key)
# ----------------------------------------
# OSM_USER_AGENT: User agent string cho Overpass API requests
# Nên chứa contact info để OSM team có thể liên hệ nếu có vấn đề
OSM_USER_AGENT=SmartTourismPlatform/1.0 (contact@yourdomain.com)

# OSM_RATE_LIMIT: Số requests tối đa mỗi phút cho Overpass API
# Default: 60 (tuân thủ usage policy của OSM)
OSM_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# CORS & SECURITY
# ============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# SECTION 4: AIRFLOW CONFIGURATION (Optional - cho advanced scheduling)
# ============================================================================
# Airflow dùng cho complex workflow orchestration nếu cần

# AIRFLOW_FERNET_KEY: Encryption key cho Airflow metadata
# GENERATE: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_airflow_fernet_key_here

# AIRFLOW_WEBSERVER_SECRET: Secret cho Airflow webserver
# GENERATE: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_WEBSERVER_SECRET=your_airflow_webserver_secret_here

# AIRFLOW_DATABASE_URL: Connection string cho Airflow metadata database
# Nên dùng PostgreSQL cho production
AIRFLOW_DATABASE_URL=postgresql+psycopg2://admin:${POSTGRES_PASSWORD}@localhost:5432/airflow

# AIRFLOW_EXECUTOR: Kiểu executor cho task scheduling
# SequentialExecutor: Single process (development only)
# LocalExecutor: Multi-process trên cùng machine
# CeleryExecutor: Distributed workers (production)
AIRFLOW_EXECUTOR=LocalExecutor

# ============================================================================
# SECTION 5: PORTS & NETWORKING
# ============================================================================
# Port configuration cho tất cả services

# BACKEND_PORT: Port cho FastAPI application
# Default: 8000
BACKEND_PORT=8000

# FRONTEND_PORT: Port cho frontend development server (React/Vue)
# Default: 3000
FRONTEND_PORT=3000

# MONGODB_PORT: Port cho MongoDB (đã định nghĩa ở trên, đây là alias)
MONGODB_PORT=27017

# REDIS_PORT: Port cho Redis (đã định nghĩa ở trên, đây là alias)
REDIS_PORT=6379

# AIRFLOW_WEBSERVER_PORT: Port cho Airflow UI
# Default: 8080
AIRFLOW_WEBSERVER_PORT=8080

# PROMETHEUS_PORT: Port cho Prometheus metrics server
# Default: 9090
PROMETHEUS_PORT=9090

# GRAFANA_PORT: Port cho Grafana dashboards
# Default: 3001 (tránh conflict với frontend port 3000)
GRAFANA_PORT=3001

# ----------------------------------------
# Public URLs
# ----------------------------------------
# NEXT_PUBLIC_API_URL: URL cho frontend gọi API
# Development: http://localhost:8000/api
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# API_BASE_URL: Internal API base URL cho microservices communication
API_BASE_URL=http://localhost:8000

# ============================================================================
# SECTION 6: HTTPS/TLS & SECURITY (Production Only)
# ============================================================================
# SSL certificates cho HTTPS termination
# Không cần nếu dùng reverse proxy (nginx, traefik, cloudflare)

# ENABLE_HTTPS: Bật HTTPS trực tiếp trong Uvicorn
# true: HTTPS enabled (cần SSL certificates)
# false: HTTP only (dùng reverse proxy cho HTTPS)
ENABLE_HTTPS=false

# SSL_CERT_PATH: Path đến SSL certificate file (.crt hoặc .pem)
SSL_CERT_PATH=/etc/ssl/certs/your_cert.crt

# SSL_KEY_PATH: Path đến SSL private key file (.key)
SSL_KEY_PATH=/etc/ssl/private/your_key.key

# SSL_CA_PATH: Path đến CA certificate (optional, cho client cert verification)
SSL_CA_PATH=/etc/ssl/certs/ca-cert.crt

# ----------------------------------------
# Security Headers
# ----------------------------------------
# STRICT_TRANSPORT_SECURITY: HSTS header (force HTTPS)
# max-age=31536000: 1 year
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains

# CONTENT_SECURITY_POLICY: CSP header (prevent XSS)
# Adjust theo frontend requirements
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ============================================================================
# SECTION 7: MONITORING, LOGGING & OBSERVABILITY
# ============================================================================
# Integration với monitoring services

# ----------------------------------------
# Sentry (Error Tracking)
# ----------------------------------------
# SENTRY_DSN: Sentry project DSN cho error tracking
# Get tại: https://sentry.io/settings/projects/{project}/keys/
# Format: https://publickey@o0.ingest.sentry.io/0
SENTRY_DSN=https://public_key@o0.ingest.sentry.io/project_id

# SENTRY_ENVIRONMENT: Environment label trong Sentry
SENTRY_ENVIRONMENT=development

# SENTRY_RELEASE: Release version cho source maps
SENTRY_RELEASE=1.0.0

# ----------------------------------------
# Datadog (APM & Metrics)
# ----------------------------------------
# DATADOG_API_KEY: API key cho Datadog agent
DATADOG_API_KEY=optional_datadog_api_key_here

# DATADOG_APP_KEY: Application key cho Datadog API access
DATADOG_APP_KEY=optional_datadog_app_key_here

# DATADOG_SITE: Datadog site domain
# US: datadoghq.com
# EU: datadoghq.eu
DATADOG_SITE=datadoghq.com

# ----------------------------------------
# Prometheus & Grafana
# ----------------------------------------
# PROMETHEUS_RETENTION: Thời gian lưu metrics (15d, 30d, 1y)
PROMETHEUS_RETENTION=15d

# GRAFANA_ADMIN_USER: Username cho Grafana admin
GRAFANA_ADMIN_USER=admin

# GRAFANA_ADMIN_PASSWORD: Password cho Grafana admin (PHẢI thay đổi!)
GRAFANA_ADMIN_PASSWORD=admin123

# ============================================================================
# SECTION 8: DEPLOYMENT & CI/CD
# ============================================================================
# Configuration cho Docker và deployment automation

# ----------------------------------------
# Docker Registry
# ----------------------------------------
# DOCKER_REGISTRY: Container registry URL
# Docker Hub: docker.io
# AWS ECR: aws_account_id.dkr.ecr.region.amazonaws.com
# GCP GCR: gcr.io
# Azure ACR: your_registry.azurecr.io
DOCKER_REGISTRY=docker.io

# DOCKER_REGISTRY_USERNAME: Username cho registry authentication
DOCKER_REGISTRY_USERNAME=your_docker_username

# DOCKER_REGISTRY_PASSWORD: Password hoặc access token cho registry
DOCKER_REGISTRY_PASSWORD=your_docker_password_or_token

# DOCKER_IMAGE_NAME: Tên image cho ứng dụng này
DOCKER_IMAGE_NAME=smart-tourism-api

# DOCKER_IMAGE_TAG: Version tag cho image
# Use git commit hash hoặc semantic versioning
DOCKER_IMAGE_TAG=latest

# ----------------------------------------
# GitHub Actions / CI/CD
# ----------------------------------------
# GITHUB_TOKEN: Token cho GitHub Actions (tự động set bởi GitHub)
GITHUB_TOKEN=optional_github_token_for_actions

# DEPLOY_WEBHOOK_URL: Webhook URL để trigger deployment
DEPLOY_WEBHOOK_URL=https://your-cd-platform.com/webhook/deploy

# ----------------------------------------
# Kubernetes (nếu dùng K8s)
# ----------------------------------------
# KUBE_CONFIG_PATH: Path đến kubeconfig file
KUBE_CONFIG_PATH=~/.kube/config

# KUBE_NAMESPACE: Kubernetes namespace cho deployment
KUBE_NAMESPACE=smart-tourism

# HELM_RELEASE_NAME: Tên Helm release
HELM_RELEASE_NAME=smart-tourism-api

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# REMEMBER:
# 1. Copy file này: cp .env.example .env
# 2. Thay đổi TẤT CẢ default values trong .env
# 3. Không bao giờ commit file .env
# 4. Chạy ứng dụng: python src/main.py (dev) hoặc docker-compose up (prod)
# ============================================================================