{
    "dashboard": {
        "title": "Smart Travel Platform",
        "tags": [
            "smart-travel"
        ],
        "timezone": "browser",
        "panels": [
            {
                "title": "API Response Time",
                "type": "timeseries",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"smart-travel-api\"}[5m]))",
                        "legendFormat": "95th percentile"
                    }
                ]
            },
            {
                "title": "Pipeline Success Rate",
                "type": "stat",
                "targets": [
                    {
                        "expr": "rate(airflow_dag_run_success_total[1h]) / rate(airflow_dag_run_total[1h]) * 100",
                        "legendFormat": "Success Rate %"
                    }
                ]
            },
            {
                "title": "Database Connections",
                "type": "gauge",
                "targets": [
                    {
                        "expr": "mongodb_connections_current",
                        "legendFormat": "Active Connections"
                    }
                ]
            }
        ],
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "refresh": "30s"
    }
}