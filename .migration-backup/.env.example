# Database
# Use the credential variables below to build connection URIs
MONGODB_URI=mongodb://admin:${MONGODB_PASSWORD}@localhost:27017
DB_NAME=smart_travel
POSTGRES_URL=postgresql+asyncpg://admin:${POSTGRES_PASSWORD}@localhost:5432/smart_travel
REDIS_URL=redis://localhost:6379

# API Keys
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Airflow
AIRFLOW_FERNET_KEY=your-airflow-fernet-key-here
AIRFLOW_WEBSERVER_SECRET=your-airflow-webserver-secret-here

# External Services
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# ============================================================================
# SMART TRAVEL DATA PLATFORM - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Keep .env in .gitignore and never commit secrets

# ============================================================================
# DATABASE
# ============================================================================
MONGODB_USER=admin
MONGODB_PASSWORD=your_secure_mongodb_password_here
MONGODB_DATABASE=smart_travel
MONGODB_PORT=27017

POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=smart_travel
POSTGRES_PORT=5432

# MinIO (object storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_secure_minio_secret_here

REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379

# ============================================================================
# APPLICATION
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# Secret key for JWT signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your_super_secret_key_change_this_in_production
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# EXTERNAL APIs
# ============================================================================
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ============================================================================
# CORS & SECURITY
# ============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# AIRFLOW
# ============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_airflow_fernet_key_here

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_WEBSERVER_SECRET=your_airflow_webserver_secret_here

# ============================================================================
# API ENDPOINTS
# ============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
AIRFLOW_WEBSERVER_PORT=8080

NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ============================================================================
# HTTPS/TLS (Production)
# ============================================================================
# Only needed for production
ENABLE_HTTPS=false
SSL_CERT_PATH=/etc/ssl/certs/your_cert.crt
SSL_KEY_PATH=/etc/ssl/private/your_key.key

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
SENTRY_DSN=optional_sentry_dsn_for_error_tracking
DATADOG_API_KEY=optional_datadog_api_key

# ============================================================================
# DEPLOYMENT
# ============================================================================
DOCKER_REGISTRY=docker.io
DOCKER_REGISTRY_USERNAME=your_docker_username
DOCKER_REGISTRY_PASSWORD=your_docker_password