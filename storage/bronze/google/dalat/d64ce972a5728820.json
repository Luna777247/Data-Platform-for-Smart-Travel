      {
        "author_name": "Glorya Nguyen",
        "author_url": "https://www.google.com/maps/contrib/105518679761475809967/reviews",
        "language": "vi",
        "original_language": "vi",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjVLSPgOWs87SfIIT2H-iJcZaiBGszw5nUGTMXDLDGslnbUeUN4=s128-c0x00000000-cc-rp-mo",
        "rating": 3,
        "relative_time_description": "3 tháng trước",
        "text": "Không gian ổn. Không có chỗ để oto. Đồ ăn dở tệ. Không nên ăn hai món mik để dưới đây. Nhìn thì ngon ăn thì dở",
        "time": 1767748316,
        "translated": false
