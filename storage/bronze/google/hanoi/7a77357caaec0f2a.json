        "original_language": "vi",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjWneLs1LKcghjAqs-K5inA-zIgEGlIanKdnFOO_biKAf3CmKus=s128-c0x00000000-cc-rp-mo-ba5",
        "rating": 5,
        "relative_time_description": "một tháng trước",
        "text": "Mình ít uống cafe nhưng khi thử tại cafe thái thì thấy rất ngon nhé lần tới đến hà nội sẽ thử lại 😊",
